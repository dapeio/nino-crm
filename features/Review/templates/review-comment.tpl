<li class="review-comment[[modifier]]" data-review-id="[[id]]"[[at]]>
	<div class="review-comment__head">
		[[time]]
		<strong class="review-comment__who">[[who]]</strong>
		<time class="review-comment__date" datetime="[[created]]">[[date]]</time>
		[[mark]]
	</div>
	<p class="review-comment__text">[[text]]</p>
	[[reply]]
	[[answers]]
</li>
