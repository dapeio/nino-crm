<div style="max-width:600px; margin:0 auto; padding:[[/project/mail/spacing/large]] [[/project/mail/spacing/medium]]; background:[[/project/mail/color/background]]; color:[[/project/mail/color/text]]; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height:[[/project/mail/font/line-height]];">
	<h1 style="margin:0 0 [[/project/mail/spacing/medium]]; font-size:[[/project/mail/font/large]]; color:[[/project/mail/color/text]];">[[heading]]</h1>
	<p style="margin:0 0 [[/project/mail/spacing/medium]];">[[intro]]</p>
	<p style="margin:0 0 [[/project/mail/spacing/medium]];"><strong>[[project]]</strong><br>[[client]]<br>[[files]]</p>
	<p style="margin:0 0 [[/project/mail/spacing/medium]];">[[account]]</p>
	<p style="margin:0 0 [[/project/mail/spacing/medium]]; text-align:center;">
		<a href="[[link]]" style="display:inline-block; padding:[[/project/mail/spacing/small]] [[/project/mail/spacing/medium]]; background:[[/project/mail/color/primary]]; color:[[/project/mail/color/background]]; text-decoration:none;">[[cta]]</a>
	</p>
	<p style="margin:0; font-size:[[/project/mail/font/small]];">[[notice]]</p>
</div>
