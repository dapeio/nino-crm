<li class="crm-files__row crm-table__row[[playing]]" data-files-id="[[id]]" data-files-mime="[[mime]]"[[current]]>
	<div class="crm-files__line crm-table__line">
		<span class="crm-files__file crm-table__cell"><span class="crm-files__icon">[[icon:[[icon]]]]</span><span class="crm-files__text">[[title]][[version]][[ext]][[versions]][[new]][[mark]][[open]]</span></span>
		<span class="crm-files__size crm-table__cell">[[size]]</span>
		<time class="crm-files__date crm-table__cell" datetime="[[created]]">[[date]]</time>
		<span class="crm-files__links crm-table__cell crm-table__actions">[[listen]][[download]]</span>
	</div>
</li>
