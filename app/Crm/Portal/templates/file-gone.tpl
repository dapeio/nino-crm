<li class="crm-files__row crm-files__row--gone crm-table__row" data-files-id="[[id]]" data-files-mime="[[mime]]" data-files-gone="">
	<div class="crm-files__line crm-table__line">
		<span class="crm-files__file crm-table__cell"><span class="crm-files__icon">[[icon:[[icon]]]]</span><span class="crm-files__text"><span class="crm-files__name">[[name]]</span></span></span>
		<span class="crm-facts">
			<span class="crm-files__size crm-table__cell">[[size]]</span>
			<time class="crm-files__date crm-table__cell" datetime="[[created]]">[[date]]</time>
		</span>
		<span class="crm-files__links crm-table__cell crm-table__actions"></span>
		<p class="crm-files__gone crm-table__cell">[[gone]]</p>
	</div>
</li>
