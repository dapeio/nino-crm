<details class="crm-offer crm-card" id="angebot-[[id]]" data-document="[[id]]" data-state="[[state]]"[[open]]>
			<summary class="crm-offer__summary">
				<span class="crm-offer__chevron">[[icon:chevron-down]]</span>
				<span class="crm-offer__head">
					<span class="crm-offer__title">[[title]]</span>
					<span class="crm-offer__meta"><span class="crm-offer__number">[[number]]</span> · <time class="crm-offer__date" datetime="[[iso]]">[[date]]</time>[[valid]]</span>
				</span>
				<span class="crm-offer__gross">[[gross]]</span>
				<span class="crm-offer__state crm-pill crm-pill--[[tone]]">[[word]]</span>
				<a class="crm-offer__download crm-btn crm-btn--secondary crm-btn--small" href="[[dir]]/.crm/pdf/[[id]]?download=1">[[icon:download]]<span>[[/project/crm-documents/list/download]]</span><span class="nino-sr-only"> [[number]]</span></a>
			</summary>
			<div class="crm-offer__body">
				<ul class="crm-offer__lines">
					[[lines]]
				</ul>
				<dl class="crm-offer__sums">
					[[sums]]
				</dl>
				[[note]]
				[[validnote]]
				[[message]]
				[[order]]
			</div>
		</details>
