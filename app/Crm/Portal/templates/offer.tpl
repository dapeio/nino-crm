<div class="crm-offer crm-card" data-document="[[id]]" data-state="[[state]]">
			<div class="crm-offer__head">
				<h5 class="crm-offer__title">[[title]]</h5>
				<time class="crm-offer__date" datetime="[[iso]]">[[date]]</time>
				[[valid]]
				<span class="crm-offer__state crm-chip">[[/project/crm-documents/state/[[state]]]]</span>
			</div>
			<ul class="crm-offer__lines">
				[[lines]]
			</ul>
			<dl class="crm-offer__sums">
				[[sums]]
			</dl>
			[[note]]
			<p class="crm-offer__actions"><a class="crm-offer__download" href="[[dir]]/.crm/pdf/[[id]]?download=1">[[/project/crm-documents/list/download]]</a></p>
			[[order]]
		</div>
