<li class="crm-dates__row crm-card" id="termin-[[slug]]" data-date="[[slug]]">
			<time class="crm-dates__when" datetime="[[iso]]"><span class="crm-dates__day">[[day]]</span><span class="crm-dates__month">[[month]]</span></time>
			<div class="crm-dates__body">
				<span class="crm-dates__title">[[title]]</span>
				<span class="crm-dates__meta"><span class="crm-dates__time">[[icon:clock]][[when]]</span>[[place]]</span>
			</div>
			<span class="crm-btn crm-btn--secondary crm-btn--small crm-btn--holds crm-dates__ics">[[icon:calendar-plus]][event-ics text="[[slug]]"]</span>
		</li>
