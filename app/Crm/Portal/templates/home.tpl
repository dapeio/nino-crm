<div class="crm-home crm-note crm-note--info" role="note" data-crm-home hidden>
	[[icon:smartphone]]
	<div class="crm-home__body">
		<p class="crm-home__title">[[/project/crm-portal/home/title]]</p>
		<p class="crm-home__system" data-crm-system="ios"><strong>[[/project/crm-portal/home/ios-name]]</strong> [[/project/crm-portal/home/ios]]</p>
		<p class="crm-home__system" data-crm-system="android"><strong>[[/project/crm-portal/home/android-name]]</strong> [[/project/crm-portal/home/android]]</p>
		<p class="crm-home__actions">
			<button type="button" class="crm-btn crm-btn--primary crm-btn--small" data-crm-install hidden>[[icon:smartphone]]<span>[[/project/crm-portal/home/install]]</span></button>
			<button type="button" class="crm-btn crm-btn--secondary crm-btn--small" data-crm-dismiss>[[/project/crm-portal/home/dismiss]]</button>
		</p>
	</div>
</div>
