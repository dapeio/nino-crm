<!-- nino:template-name Portal signatures -->
[template /templates/html-header]
<div class="nino-wrap">

<section id="intro" class="nino-section">
	<div class="nino-grid-row">
		<div class="nino-grid-100">
			[title /template/page-portal-sign/intro/title tag="h2"]
			[text /template/page-portal-sign/intro/text]
			[sign-list]
			[button /template/page-portal-sign/back/label href="/template/page-portal-sign/back/href" style="outline"]
		</div>
	</div>
</section>

</div>
[template /templates/html-footer]
